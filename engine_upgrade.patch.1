+    answer = x;
+    ending = "Determine x.";
+  } else if (target === "y") {
+    answer = y;
+    ending = "Determine y.";
+  } else if (target === "sum") {
+    answer = x + y;
+    ending = "Determine x + y without reporting the two values separately.";
+  } else {
+    answer = x - y;
+    ending = "Determine x - y.";
